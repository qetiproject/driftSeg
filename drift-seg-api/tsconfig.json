{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/common": ["libs/common/src"],
      "@app/common/*": ["libs/common/src/*"],
      "@apps/customer/src/constants": ["apps/customer/src/constants"],
      "@apps/customer/src/constants/*": ["apps/customer/src/constants/*"],
      "@apps/customer/src/repositories": ["apps/customer/src/repositories"],
      "@apps/customer/src/repositories/*": ["apps/customer/src/repositories/*"],
      "@apps/customer/src/dto/*": ["apps/customer/src/dto/*"],
      "@apps/customer/src/utils": ["apps/customer/src/utils"],
      "@apps/customer/src/utils/*": ["apps/customer/src/utils/*"],
      "@customer/*": ["apps/customer/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "docs"]
}
