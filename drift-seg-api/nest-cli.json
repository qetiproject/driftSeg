{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/customer/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/customer/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/customer",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "customer": {
      "type": "application",
      "root": "apps/customer",
      "entryFile": "main",
      "sourceRoot": "apps/customer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/customer/tsconfig.app.json"
      }
    },
    "segment": {
      "type": "application",
      "root": "apps/segment",
      "entryFile": "main",
      "sourceRoot": "apps/segment/src",
      "compilerOptions": {
        "tsConfigPath": "apps/segment/tsconfig.app.json"
      }
    }
  }
}
